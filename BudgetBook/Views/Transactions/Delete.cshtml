@model BudgetBook.Models.Transaction

@{
    ViewData["Title"] = "Buchung löschen";
}

<h1>Buchung löschen</h1>

<h3>Soll diese Buchung wirklich gelöscht werden?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Typ</dt>
        <dd class="col-sm-10">@Model.Type</dd>

        <dt class="col-sm-2">Betrag</dt>
        <dd class="col-sm-10">@Model.Amount.ToString("0.00")</dd>

        <dt class="col-sm-2">Datum</dt>
        <dd class="col-sm-10">@Model.BookingDate.ToString("dd.MM.yyyy")</dd>

        <dt class="col-sm-2">Kategorie</dt>
        <dd class="col-sm-10">@(Model.Category == null ? "" : Model.Category.Name + " - " + Model.Category.Type)</dd>

        <dt class="col-sm-2">Beschreibung</dt>
        <dd class="col-sm-10">@Model.Description</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Löschen" class="btn btn-danger" /> |
        <a asp-action="Index">Zurück zur Liste</a>
    </form>
</div>
