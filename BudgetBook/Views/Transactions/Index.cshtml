@model IEnumerable<BudgetBook.Models.Transaction>

@{
    ViewData["Title"] = "Buchungen";
}

<h1>Buchungen</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Neue Buchung</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Typ</th>
            <th>Betrag</th>
            <th>Datum</th>
            <th>Kategorie</th>
            <th>Beschreibung</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(model => item.Type)</td>
            <td>@Html.DisplayFor(model => item.Amount)</td>
            <td>@Html.DisplayFor(model => item.BookingDate)</td>
            <td>@(item.Category == null ? "" : item.Category.Name + " - " + item.Category.Type)</td>
            <td>@Html.DisplayFor(model => item.Description)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Bearbeiten</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Loeschen</a>
            </td>
        </tr>
}
    </tbody>
</table>
