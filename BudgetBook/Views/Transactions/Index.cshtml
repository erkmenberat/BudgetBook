@model IEnumerable<BudgetBook.Models.Transaction>

@{
    ViewData["Title"] = "Buchungen";
}

<h1>Buchungen</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Neue Buchung</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Typ</th>
            <th>Betrag</th>
            <th>Datum</th>
            <th>Kategorie</th>
            <th>Beschreibung</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@if (!Model.Any())
{
        <tr>
            <td colspan="6">Es wurden noch keine Buchungen angelegt.</td>
        </tr>
}
else
{
@foreach (var item in Model) {
        <tr>
            <td>@item.Type</td>
            <td>@item.Amount.ToString("0.00")</td>
            <td>@item.BookingDate.ToString("dd.MM.yyyy")</td>
            <td>@(item.Category == null ? "" : item.Category.Name + " - " + item.Category.Type)</td>
            <td>@item.Description</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Bearbeiten</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Löschen</a>
            </td>
        </tr>
}
}
    </tbody>
</table>
