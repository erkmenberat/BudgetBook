@model BudgetBook.ViewModels.StatisticsViewModel

@{
    ViewData["Title"] = "Statistik";
}

<h1>Statistik</h1>

<form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label asp-for="From" class="form-label"></label>
        <input asp-for="From" type="date" class="form-control" />
        <span asp-validation-for="From" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <label asp-for="To" class="form-label"></label>
        <input asp-for="To" type="date" class="form-control" />
        <span asp-validation-for="To" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <label asp-for="Type" class="form-label"></label>
        <select asp-for="Type" asp-items="Model.TypeOptions" class="form-select">
            <option value="">Alle</option>
        </select>
        <span asp-validation-for="Type" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <label asp-for="CategoryId" class="form-label"></label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="">Alle</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filtern</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Zurücksetzen</a>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger" role="alert">
        <strong>Der Filter ist ungültig. Es werden keine Zahlen berechnet.</strong>
        <div asp-validation-summary="All"></div>
    </div>
}
else
{
    <partial name="_StatisticsResults" model="Model" />
}
